<Configuration status="debug">
  <Appenders>
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout charset="UTF-8" pattern="%d %-5p [%t] %C{2} (%F:%L) - %m%n"/>
    </Console>
    <File name="LOG_FILE" fileName="log.txt" charset="UTF-8">
      <PatternLayout charset="UTF-8" pattern="%d %-5p [%t] %C{2} (%F:%L) - %m%n"/>
    </File>
    <Async name="ASYNC">
      <AppenderRef ref="TEMP"/>
      <AppenderRef ref="CONSOLE"/>
    </Async>
  </Appenders>
  <Loggers>
    <!-- MyBatis SQL日志：DEBUG=SQL+参数，TRACE=SQL+参数+结果集 -->
    <Logger name="mybatis.mapper" level="DEBUG"/>
    <Root level="INFO">
      <AppenderRef ref="CONSOLE"/>
    </Root>
  </Loggers>
</Configuration>
